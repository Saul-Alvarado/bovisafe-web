{
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "rewrites": [
    {
      "source": "/runtime-config",
      "destination": "/api/config"
    },
    {
      "source": "/((?!api/|assets/|geo/|runtime-config).*)",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/runtime-config",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        }
      ]
    }
  ],
  "git": {
    "deploymentEnabled": false
  },
  "installCommand": "npm ci"
}
